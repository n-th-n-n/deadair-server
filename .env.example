# Deadair settings. `npm start` copies this to .env on first run, and `npm run setup:cloud`
# fills in the Worker URLs and secrets. You don't need to edit anything by hand except
# CF_DNS_API_TOKEN (only for `npm run https`). Never commit .env.

# Posters & metadata (TMDB API Read Access Token). Optional here: once any machine has it,
# it's kept in D1 and every other machine picks it up. You can also paste it in Settings.
TMDB_API_KEY=

# Login: checked by the auth-gateway Worker (auth-gateway/). Filled in by `npm run setup:cloud`.
AUTH_GATEWAY_URL=
AUTH_GATEWAY_SECRET=

# Your data in D1 via the deadair-api Worker (worker/). Filled in by `npm run setup:cloud`.
DEADAIR_API_URL=
DEADAIR_API_SECRET=

# Who can use Deadair (comma-separated usernames from the users database). Nobody else can sign in.
# Admins manage libraries and settings; ALLOWED_USERS can only browse and watch.
ADMIN_USERS=
ALLOWED_USERS=

# HTTPS on your own domain (`npm run https`): the hostname Deadair answers on, and a Cloudflare
# "Edit zone DNS" token for its zone, used to point it at this machine and to get certificates.
DEADAIR_DOMAIN=deadair.example.com
CF_DNS_API_TOKEN=

# Plugins (plugins/<name>) read their settings from this file too: see each plugin's README.
